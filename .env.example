# ---- Required ----
# OpenAI: chat model, background fact extraction, and embeddings for memory recall.
OPENAI_API_KEY=
# Tavily: the agent's one tool, web search. Free key at https://tavily.com
TAVILY_API_KEY=

# ---- Optional ----
# PORT=3000
# HOST=127.0.0.1                      # there is no login: keep it on localhost unless you know why not
# OPENAI_MODEL=gpt-6.1-sol            # chat model (gpt-6-astra = flagship, slower and pricier)
# OPENAI_REASONING_EFFORT=low         # low | medium | high — lower answers faster
# OPENAI_EXTRACT_MODEL=gpt-6-luna     # background fact extraction and titles
# SEARCH_DEPTH=advanced               # advanced | basic (Tavily search depth)
# DB_PATH=./data/minimi.db
# MINIMI_NOW=2026-11-11T12:30:00+05:30   # pretend it is this moment (for demos over imported history)
